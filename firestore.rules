// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && getRole() == 'teacher';
    }

    function isParent() {
      return isSignedIn() && getRole() == 'parent';
    }

    function isStudent() {
      return isSignedIn() && getRole() == 'student';
    }

    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrTeacher();
    }

    // Teachers
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Classes
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Timetable
    match /timetable/{entryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Attendance
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrTeacher();
    }

    // Grades
    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrTeacher();
    }

    // Finance
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /feeStructures/{feeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
